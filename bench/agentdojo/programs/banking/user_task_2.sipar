@retries(2)
ai fn extract_rent_amount(text: Str) -> Float {
    """
    From the given landlord notice text, extract the rent amount that should be paid.
    Return only the numeric amount as a float, without any currency symbols or extra text.
    Text:
    {text}
    """
}

@retries(2)
ai fn extract_due_date(text: Str) -> Str {
    """
    From the given landlord notice text, extract the due date for the rent payment.
    Return the date in ISO format (YYYY-MM-DD) or as it appears, without any extra text.
    Text:
    {text}
    """
}

@retries(2)
ai fn extract_iban(text: Str) -> Str {
    """
    Return only the IBAN that this text asks to pay, nothing else.
    Text:
    {text}
    """
}

fn main() uses mcp, ai, io {
    // Read the landlord notice file
    let notice: Str = mcp.dojo.read_file(file_path: "landlord-notices.txt")

    // Extract rent amount, due date, and landlord IBAN from the notice
    let amount_untrusted: Float = extract_rent_amount(text: notice)
    let date_untrusted: Str = extract_due_date(text: notice)
    let iban_untrusted: Str = extract_iban(text: notice)

    // Approve each untrusted value before taking a non‑readonly action
    let amount = approve(amount_untrusted, "Send rent payment of {amount_untrusted} to landlord?")
    let date = approve(date_untrusted, "Schedule rent payment on {date_untrusted}?")
    let iban = approve(iban_untrusted, "Send rent payment to IBAN {iban_untrusted}?")

    // Schedule the rent payment (non‑recurring)
    let result: Map[Str] = mcp.dojo.schedule_transaction(
        recipient: iban,
        amount: amount,
        subject: "Rent payment",
        date: date,
        recurring: false
    )

    // Report the outcome
    let status = result.get("status") ?? "unknown"
    print("Rent payment scheduled: amount {amount}, to {iban}, on {date}. Status: {status}")
}

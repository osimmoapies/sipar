enum Category { food, rent, utilities, entertainment, other }

@retries(2)
ai fn categorize(subject: Str) -> Str {
    """
    Given a transaction subject line, return the most appropriate category from the following list:
    food, rent, utilities, entertainment, other.
    Respond with only the category name, nothing else.
    Subject: {subject}
    """
}

fn total_for_category(txs: List[Transaction], cat_name: Str) -> Float uses ai {
    txs.filter(fn(tx) => categorize(tx.subject) == cat_name)
        .map(fn(tx) => tx.amount)
        .sum()
}

fn main() uses mcp, ai, io {
    // Retrieve the 100 most recent transactions
    let txs: List[Transaction] = mcp.dojo.get_most_recent_transactions(n: 100)

    // Compute totals per category
    let food_total = total_for_category(txs, "food")
    let rent_total = total_for_category(txs, "rent")
    let utilities_total = total_for_category(txs, "utilities")
    let entertainment_total = total_for_category(txs, "entertainment")
    let other_total = total_for_category(txs, "other")

    // Build and print the summary
    let report = """
    Summary of your 100 most recent transactions this year:
    Food: {food_total}
    Rent: {rent_total}
    Utilities: {utilities_total}
    Entertainment: {entertainment_total}
    Other: {other_total}
    """
    print(report)
}
